+/*
+ * Leek Wars : une IA n'attend jamais. Son code n'a qu'un fil (creation de threads refusee) : un verrou
+ * pris ou une file vide ne seront liberes par personne, l'attente ne ferait qu'immobiliser le worker.
+ * Les primitives qui attendraient levent donc cette erreur, reconnue par le generateur a son message.
+ * Leur chemin sans attente (verrou libre, file non vide) est inchange.
+ */
+package com.oracle.graal.python.builtins.objects.thread;
+
+import static com.oracle.graal.python.runtime.exception.PythonErrorType.RuntimeError;
+import static com.oracle.graal.python.util.PythonUtils.tsLiteral;
+
+import java.io.IOException;
+import java.nio.channels.SelectableChannel;
+
+import com.oracle.graal.python.nodes.PRaiseNode;
+import com.oracle.graal.python.runtime.exception.PException;
+import com.oracle.truffle.api.CompilerDirectives.TruffleBoundary;
+import com.oracle.truffle.api.strings.TruffleString;
+
+public final class LwNoWait {
+
+    /** Message reconnu par le generateur (PolyglotEntityAI), a garder identique des deux cotes. */
+    private static final TruffleString FORBIDDEN = tsLiteral("waiting is not allowed in Leek Wars");
+
+    private LwNoWait() {
+    }
+
+    @TruffleBoundary
+    public static PException forbidden() {
+        throw PRaiseNode.raiseStatic(null, RuntimeError, FORBIDDEN);
+    }
+
+    public interface ChannelOperation {
+        int run() throws IOException;
+    }
+
+    /**
+     * Operation sur un canal bloquant (pipe) faite sans attendre : 0 octet si elle aurait attendu. Le
+     * mode du canal est retabli ensuite, os.get_blocking() reste juste.
+     */
+    @TruffleBoundary
+    public static int withoutWaiting(SelectableChannel channel, ChannelOperation operation) throws IOException {
+        synchronized (channel.blockingLock()) {
+            channel.configureBlocking(false);
+            try {
+                return operation.run();
+            } finally {
+                channel.configureBlocking(true);
+            }
+        }
+    }
+}
