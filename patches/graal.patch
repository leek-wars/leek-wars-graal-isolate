@@ -97,6 +97,13 @@ class ToolchainTestBuildTask(mx.BuildTask):
     def build(self):
         mx_util.ensure_dir_exists(self.subject.get_output_root())
 
+        # LW spike: skip the toolchain smoke test on a noexec build partition.
+        # The isolate image is linked with the system toolchain; the LLVM toolchain
+        # test would exec binaries from the noexec mount and abort the build.
+        if os.environ.get('LW_SKIP_TOOLCHAIN_TEST'):
+            mx.log("LW spike: skipping LLVM toolchain smoke test (LW_SKIP_TOOLCHAIN_TEST)")
+            return
+
         toolchainPath = mx.distribution('LLVM_TOOLCHAIN').output
         clang = os.path.join(toolchainPath, 'bin', 'clang')
         clangxx = os.path.join(toolchainPath, 'bin', 'clang++')
